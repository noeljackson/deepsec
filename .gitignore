# Build output
/deepsec
/bin/
dist/

# Deepsec scan data (root-level only; `.deepsec/data/` in consumer repos is intentionally tracked)
/data/

# Local deepsec config from `deepsec init` (each contributor generates their own)
/deepsec.config.toml

# Test / coverage artifacts
*.test
*.out
/.tmp/
/bench/out/
/bench/out-processor/
/bench/out-agent/

# Bake-off ephemera. Each codex session writes its brief here and a
# `*-RESULTS.md` report at the repo root summarising what it built;
# both are session-local and should never land on main.
/.*-brief.md
/AGENT-RESULTS.md
/BENCH-RESULTS.md
/EXTERN-RESULTS.md
/PROC-RESULTS.md
/REPEAT-RESULTS.md
/REVIEW-RESULTS.md

# Agent decisions log is per-machine (records local autonomous
# matcher patches). Production audit logs of the agent run elsewhere.
/AGENT_DECISIONS.md

# Secrets and local env
.env*.local

# Editor / tool state
.DS_Store
.claude

# Local workflow files
linear-*
plans/
